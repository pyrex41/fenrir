(library "processor.fen")

\\ Updating key 2 creates distinct Branch parents that still share the Pair for key 0.
(define main {I64 --> (Tuple Bool Bool Bool)}
  input -> (let child (update-pair Vacant 0 3 input)
                left (update-group child 2 4 7)
                right (update-group left 2 6 13)
                changed (update-group left 0 5 11)
                changed-ok (= (flatten changed NoKeys)
                              (Key 0 2 8 (+ input 11) (Key 2 1 4 7 NoKeys)))
                right-ok (= (flatten right NoKeys)
                            (Key 0 1 3 input (Key 2 2 10 20 NoKeys)))
                distinct (not (= changed right))
             (tuple changed-ok right-ok distinct)))
