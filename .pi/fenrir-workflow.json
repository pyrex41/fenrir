{
  "version": 1,
  "requireContinuousContext": true,
  "protectedPaths": [
    "tests/fenrir-workflow"
  ],
  "ignoredPaths": [
    "node_modules",
    "build"
  ],
  "requiredChecks": [
    "tc0-a-qualification"
  ],
  "requiredClaims": [
    "canonical-program",
    "hand-derived-trace",
    "model-candidate-agreement",
    "defect-discovered-and-reduced",
    "exact-original-failure-replay",
    "fresh-repair-evaluation"
  ],
  "checks": {
    "workflow-tests": {
      "kind": "development",
      "command": [
        "node",
        "--test",
        "tests/fenrir-workflow/core.test.mjs",
        "tests/fenrir-workflow/runner.test.mjs",
        "tests/fenrir-workflow/extension.test.mjs"
      ],
      "timeoutSeconds": 60,
      "authorityPaths": [
        "tests/fenrir-workflow"
      ]
    },
    "tc0-candidate-tests": {
      "kind": "development",
      "command": [
        "node",
        "--test",
        "tests/tc0/canonical.test.mjs",
        "tests/tc0/closure-alias.test.mjs",
        "tests/tc0/closure-replay.test.mjs",
        "tests/tc0/closure.test.mjs",
        "tests/tc0/digest-cache.test.mjs",
        "tests/tc0/expression.test.mjs",
        "tests/tc0/generate.test.mjs",
        "tests/tc0/pure-call-artifact.test.mjs",
        "tests/tc0/pure-call-coverage.test.mjs",
        "tests/tc0/pure-call-generation.test.mjs",
        "tests/tc0/pure-call-machine.test.mjs",
        "tests/tc0/pure-call-replay.test.mjs",
        "tests/tc0/pure-data-generation.test.mjs",
        "tests/tc0/pure-data.test.mjs",
        "tests/tc0/reduce.test.mjs",
        "tests/tc0/reduction-bridge.test.mjs",
        "tests/tc0/replay.test.mjs",
        "tests/tc0/requirement-ledger.test.mjs",
        "tests/tc0/s3-repair.test.mjs",
        "tests/tc0/sandbox.test.mjs"
      ],
      "timeoutSeconds": 120,
      "authorityPaths": []
    },
    "tc0-pure-call-oracle": {
      "kind": "development",
      "command": [
        "sh",
        "harness/run-hand-cases.sh"
      ],
      "timeoutSeconds": 330,
      "authorityPaths": [
        "harness/hand-cases.shen",
        "harness/common.shen",
        "harness/run-hand-cases.sh"
      ]
    },
    "tc0-a-qualification": {
      "kind": "qualification",
      "command": [
        "sh",
        "harness/run-gate.sh"
      ],
      "timeoutSeconds": 1800,
      "authorityPaths": [
        "harness",
        "spec/tc0",
        "models/tc0",
        "fixtures/tc0",
        "tools/tc0",
        "runtime/tc0",
        "tools/solo5/freerun-pure-call.mjs",
        "tools/solo5/freerun.mjs",
        "tools/solo5/pure-call",
        "backends/solo5/pure-call",
        "tests/tc0",
        "campaigns/tc0/s3",
        "flake.nix",
        "flake.lock"
      ]
    }
  }
}
