(set arm.*args* (tl (value *argv*)))
(set arm.*lib* (hd (value arm.*args*)))
(module.set-path [(value arm.*lib*)])
(module.use [json])
(load (cn (hd (tl (value arm.*args*))) "/scalar.shen"))
(load (cn (hd (tl (value arm.*args*))) "/managed.shen"))
(load (cn (hd (tl (value arm.*args*))) "/printer.shen"))
(load (cn (hd (tl (value arm.*args*))) "/handler-context.shen"))
(load (cn (hd (tl (value arm.*args*))) "/handlers.shen"))
(load (cn (hd (tl (value arm.*args*))) "/tasks.shen"))
(load (cn (hd (tl (value arm.*args*))) "/arguments.shen"))
(load (cn (hd (tl (value arm.*args*))) "/constants.shen"))
(load (cn (hd (tl (value arm.*args*))) "/byte-scan.shen"))
(define arm.compile-file
  [Input Output Entry Exports Operations Profile Kind] ->
    (let Artifact (json.parse (read-file-as-string Input) [[byte-limit 16777216]])
         Descriptor (json.parse (read-file-as-string Profile) [])
         Limits (set arm.*limits* (arm.field "limits" Descriptor))
         ImageKind (set arm.*image-kind* (intern Kind))
         Name (set arm.*profile* (arm.field "id" Descriptor))
         ErrorFile (set arm.*error* (cn Output ".error"))
         Locations (set arm.*positions* (map (/. P [(arm.field "id" P) P]) (arm.field "source_map" Artifact)))
         Tasks (set mg.*tasks* (element? (arm.field "schema_version" Artifact) ["tc1-task-demo/1" "tc1-time-demo/1"]))
         Host (set mg.*host* (json.parse Operations []))
         Bindings (set mg.*exports* (json.parse Exports []))
         Symbol (set arm.*entry* Entry)
         Stream (set arm.*out* (open Output out))
      (do (set arm.*buffer* none)
          (if (and (not Tasks) (and (= Bindings []) (arm.scalar-program? Artifact))) (arm.scalar Artifact) (mg.compile Artifact)) (close Stream))))
(arm.compile-file (tl (tl (value arm.*args*))))
