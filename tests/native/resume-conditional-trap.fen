\\ > emit "before": 0
\\ > outcome: Trap DivZero
(effect Ask (ask I64 --> I64))
(define main {I64 --> I64}
  input -> (handle Ask
    ((ask x k) -> (+ (do (emit "before" x) (/ 1 x))
                     (if (= x 0)
                         (resume k (do (emit "unexpected" 1) 5))
                         (resume k 6))))
    (perform Ask ask input)))
