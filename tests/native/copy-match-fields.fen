\\ > outcome: Ok 3345
(datatype Four (Row I64 I64 I64 I64))
(define combine {(Tuple Four Four) --> Four}
  left right -> (match left
    ((Row a b c d) -> (match right
      ((Row e f g h) -> (Row c d e f))))))
(define main {I64 --> I64}
  n -> (match (combine (Row n 2 3 3) (Row 4 5 6 n))
    ((Row a b c d) -> (+ (* a 1000) (+ (* b 100) (+ (* c 10) d))))))
