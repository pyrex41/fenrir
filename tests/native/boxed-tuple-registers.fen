\\ > outcome: Ok 87654321
(define lower {(Tuple I64 I64 I64) --> I64}
  a b c -> (+ a (+ (* b 10) (* c 100))))

(define pack {(Tuple I64 I64 I64 I64 I64 I64 I64 Bytes) --> I64}
  a b c d e f g bytes ->
    (let low (tuple a b c)
      (+ (lower low) (+ (* d 1000) (+ (* e 10000) (+ (* f 100000)
        (+ (* g 1000000) (* (bytes-index bytes 0) 10000000))))))))

(define main {I64 --> I64}
  input -> (let args (tuple (+ input 1) 2 3 4 5 6 7 #x08)
             (pack args)))
