\\ Run under a given schedule: the child runs to completion before main asks: its emits all happen and await sees Ok (fixture cancel-delivered-at-scheduling-point, schedule highest).
\\ schedule highest
\\ > emit "a": 0 (task 1)
\\ > emit "b": 0 (task 1)
\\ > emit "c": 0 (task 1)
\\ > outcome: Ok 0

(define main {I64 --> I64}
  input -> (let t (spawn (lambda (_ : Unit) (do (emit "a" 0) (emit "b" 0) yield (emit "c" 0) 0)))
             (do (cancel t)
                 (match (await t) ((Ok x) -> 0) (Cancelled -> 1) ((Failed code) -> 2)))))
