\\ expect 12:18 the outcome of this remote perform is not examined: a perform of Ledger.total may only be written as the value a match takes apart
\\ Must-use: an outcome cannot be passed as an argument.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(define keep {I64 --> I64}
  x -> x)

(define main {I64 --> I64}
  input -> (keep (perform Ledger total unit)))
