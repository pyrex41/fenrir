\\ expect 6:30 effect Ask, which comes from this perform, is not allowed in a lambda that must have type (I64 --> I64)
(effect Ask (ask I64 --> I64))
(define twice {(Tuple (I64 --> I64) I64) --> I64} f x -> (f (f x)))
(define main {I64 --> I64} input ->
  (handle Ask ((ask x) -> x)
    (twice (lambda (y : I64) (perform Ask ask y)) input)))
