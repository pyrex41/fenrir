\\ expect 10:25 effect StoreRead is the peer's store and cannot be handled: its operat
\\ The store is the runtime's: no handler stands in for it.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(serve Ledger
  ((add key amount) -> (tuple 0 amount))
  ((total u) -> (handle StoreRead
                  ((get cell) -> 0)
                  (perform StoreRead get 0))))
