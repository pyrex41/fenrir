\\ expect 13:24 a program that serves does not perform remote operations: Audit.seen w
\\ A peer does not call onward: no remote perform in a program that serves.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(remote-effect Audit
  (read-only seen Unit --> I64))

(serve Ledger
  ((add key amount) -> (tuple 0 amount))
  ((total u) -> (match (perform Audit seen u)
                  ((Reply n) -> n)
                  (NotDelivered -> 0)
                  (TimedOut -> 0))))
