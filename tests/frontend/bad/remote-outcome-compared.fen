\\ expect 9:15 the outcome of this remote perform is not examined: a perform of Ledger.total may only be written as the value a match takes apart
\\ Must-use: two outcomes cannot be compared.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(define main {I64 --> Bool}
  input -> (= (perform Ledger total unit) (perform Ledger total unit)))
