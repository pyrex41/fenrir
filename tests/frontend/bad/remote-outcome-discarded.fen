\\ expect 9:16 the outcome of this remote perform is not examined: a perform of Ledger.add may only be written as the value a match takes apart
\\ Must-use: an outcome cannot be dropped in a do sequence.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(define main {I64 --> I64}
  input -> (do (perform Ledger add 7 input) 0))
