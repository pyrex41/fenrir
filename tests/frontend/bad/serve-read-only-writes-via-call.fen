\\ expect 14:17 Ledger.total is declared read-only, but its implementation can write t
\\ The write is in a function the implementation calls: its effect set carries it.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(define count-read {Unit --> I64}
  u -> (do (perform StoreWrite put 9 (+ (perform StoreRead get 9) 1))
           (perform StoreRead get 0)))

(serve Ledger
  ((add key amount) -> (tuple 0 amount))
  ((total u) -> (count-read u)))
