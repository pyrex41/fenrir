\\ expect 8:21 the outcome of this remote perform is not examined: a perform of Ledger.total may only be written as the value a match takes apart
\\ Must-use: an outcome is not the operation's value, and cannot be an operand.

(remote-effect Ledger
  (read-only total Unit --> I64))

(define main {I64 --> I64}
  input -> (+ input (perform Ledger total unit)))
