\\ expect 8:19 the argument of Ledger.total has type (Tuple I64 Unit), but Unit is expected (Ledger.total is read-only: it is performed without a request key)
\\ A read-only operation has no request key.

(remote-effect Ledger
  (read-only total Unit --> I64))

(define main {I64 --> I64}
  input -> (match (perform Ledger total 7 unit)
             ((Reply n) -> n)
             (NotDelivered -> -1)
             (TimedOut -> -2)))
