\\ expect 7:42 resumption k cannot be used inside a clause of another handler
(effect Ask (ask I64 --> I64))
(effect Tell (tell I64 --> I64))
(define main {I64 --> I64} input ->
  (handle Ask
    ((ask x k) -> (handle Tell
                    ((tell y) -> (resume k y))
                    (perform Tell tell x)))
    (perform Ask ask input)))
