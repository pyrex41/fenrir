\\ expect 9:8 the outcome of this remote perform is not examined: a perform of Ledger.total may only be written as the value a match takes apart
\\ Must-use: an outcome cannot be the result of a function.

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(define read {Unit --> I64}
  u -> (perform Ledger total u))

(define main {I64 --> I64}
  input -> (read unit))
