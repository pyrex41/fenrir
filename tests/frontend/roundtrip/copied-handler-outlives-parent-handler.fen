\\ Round trip: the TC1-C1 hand fixture copied-handler-outlives-parent-handler, in surface syntax.
\\ frontend/test.sh compares this program's run (production FIFO schedule) with the run of the fixture's artifact.

(effect Ask (ask I64 --> I64))

(define main {I64 --> I64}
  input -> (let t (handle Ask
                       ((ask x) -> (do (emit "clause" x) (+ x 100)))
                       (spawn (lambda (_ : Unit) (do yield (perform Ask ask 2)))))
             (match (await t) ((Ok r) -> r) (Cancelled -> 0) ((Failed code) -> 0))))
