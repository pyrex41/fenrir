\\ Round trip: the hand fixture request-after-resume, in surface syntax. An ordinary
\\ effect and a durable one in one program: every effect object names its class.

(effect Tx
  (begin Unit --> Unit))

(effect Store durable
  (put I64 --> I64))

(define main {I64 --> I64}
  input -> (handle Tx
             ((begin u k) -> (let r (resume k unit)
                               (do (perform Store put r)
                                   r)))
             (do (perform Tx begin unit)
                 (emit "body" 5)
                 5)))
