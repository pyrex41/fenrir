\\ Round trip: the TC1-C1 hand fixture await-failed-child-still-fails-scope, in surface syntax.
\\ frontend/test.sh compares this program's run (production FIFO schedule) with the run of the fixture's artifact.

(define main {I64 --> I64}
  input -> (let t (spawn (lambda (_ : Unit) (/ 1 0)))
             (match (await t)
               ((Ok x) -> 0)
               (Cancelled -> 1)
               ((Failed code) -> (do (emit "failed" code) 2)))))
