\\ Round trip: the TC1-C1 hand fixture explicit-cancel-does-not-fail-scope, in surface syntax.
\\ frontend/test.sh compares this program's run (production FIFO schedule) with the run of the fixture's artifact.

(define main {I64 --> I64}
  input -> (let c (channel I64 1)
             (scope (let t (spawn (lambda (_ : Unit) (match (receive c) ((Item x) -> x) (End -> 0))))
                      (do (cancel t) 7)))))
