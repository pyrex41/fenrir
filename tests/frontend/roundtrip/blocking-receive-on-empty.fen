\\ Round trip: the TC1-C1 hand fixture blocking-receive-on-empty, in surface syntax.
\\ frontend/test.sh compares this program's run (production FIFO schedule) with the run of the fixture's artifact.

(define main {I64 --> I64}
  input -> (let c (channel I64 1)
                r (spawn (lambda (_ : Unit) (do (match (receive c) ((Item x) -> (emit "got" x)) (End -> (emit "end" 0))) 0)))
                s (spawn (lambda (_ : Unit) (do (send c 5) 0)))
             0))
