\\ Round trip: the hand fixture handler-basic, in surface syntax.
\\ frontend/test.sh compares this program's run with the run of the fixture's artifact.

(effect Ask (ask I64 --> I64))

(define main {I64 --> I64}
  input -> (handle Ask
             ((ask x) -> (+ x 1))
             (+ (perform Ask ask 41) 100)))
