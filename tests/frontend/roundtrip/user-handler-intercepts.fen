\\ Round trip: the hand fixture user-handler-intercepts, in surface syntax. A user
\\ handler for a durable effect reinterprets it: nothing reaches the host.

(effect Store durable
  (put I64 --> I64))

(define main {I64 --> I64}
  input -> (handle Store
             ((put x) -> (+ x 100))
             (perform Store put 1)))
