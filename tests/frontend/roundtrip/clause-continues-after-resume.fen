\\ Round trip: the hand fixture clause-continues-after-resume, in surface syntax.
\\ frontend/test.sh compares this program's run with the run of the fixture's artifact.

(effect Ask (ask I64 --> I64))

(define main {I64 --> I64}
  input -> (handle Ask
             ((ask x k) -> (let r (resume k (+ x 1))
                             (* r 2)))
             (+ (perform Ask ask 1) 10)))
