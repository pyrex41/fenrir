\\ An outcome is a value of type (Remote B): it can be bound, passed to a
\\ function, and returned, and is taken apart by one exhaustive match wherever
\\ that is convenient. An effect set in a function type may name a remote
\\ effect, and a lambda may perform one.
\\
\\ main leaves Meter to the system, so this program does not run alone.

(remote-effect Meter
  (read-only level I64 --> I64)
  (bump (Tuple I64 I64) --> (Tuple I64 I64)))

(define value-or {(Tuple (Remote I64) I64) --> I64}
  outcome fallback -> (match outcome
                        (TimedOut -> fallback)
                        (NotDelivered -> fallback)
                        ((Reply n) -> n)))

(define ask {(I64 --> (Remote I64) ! Meter) --> I64}
  reader -> (let first (reader 1)
                 second (reader 2)
              (+ (value-or first 0) (value-or second 0))))

(define main {I64 --> I64}
  input -> (let sum (ask (lambda (x : I64) (perform Meter level x)))
             (match (perform Meter bump 3 (tuple sum 1))
               ((Reply r) -> (project r 1))
               (NotDelivered -> -1)
               (TimedOut -> -2))))
