\\ A program that declares a remote effect and never performs it: schema /3, an
\\ ordinary effect beside the remote one, and nothing left to the system, so it
\\ runs alone like any other program.
\\
\\ Expected:
\\ > emit "note": 4
\\ > outcome: Ok 5

(remote-effect Ledger
  (add I64 --> (Tuple I64 I64))
  (read-only total Unit --> I64))

(effect Note
  (note I64 --> I64))

(define main {I64 --> I64}
  input -> (handle Note
             ((note x) -> (do (emit "note" x) (+ x 1)))
             (perform Note note (+ input 4))))
