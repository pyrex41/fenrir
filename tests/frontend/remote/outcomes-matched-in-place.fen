\\ Must-use (EFFECTS.md section 3): a remote perform is written as the scrutinee
\\ of a match, and there only. Everything else is as for any expression: the
\\ match may stand in a function, in a lambda, in an arm of another match, as
\\ an argument or in a do sequence; the arms may come in any order; and an arm
\\ may decide that an outcome needs nothing done, as long as it is written.
\\ What is shared between performs is what follows the match, as functions of
\\ the reply's value, never the outcome itself. An effect set in a function
\\ type may name a remote effect.
\\
\\ main leaves Meter to the system, so this program does not run alone.

(remote-effect Meter
  (read-only level I64 --> I64)
  (bump (Tuple I64 I64) --> (Tuple I64 I64)))

(define level-or {(Tuple I64 I64) --> I64}
  x fallback -> (match (perform Meter level x)
                  (TimedOut -> fallback)
                  (NotDelivered -> fallback)
                  ((Reply n) -> n)))

(define ask {(I64 --> I64 ! Meter) --> I64}
  reader -> (+ (reader 1) (reader 2)))

(define main {I64 --> I64}
  input -> (let sum (ask (lambda (x : I64) (level-or x 0)))
             (do (match (perform Meter bump 2 (tuple sum 0))
                   ((Reply r) -> unit)
                   (NotDelivered -> unit)
                   (TimedOut -> unit))
                 (match (perform Meter bump 3 (tuple sum 1))
                   ((Reply r) -> (match (perform Meter level (project r 1))
                                   ((Reply n) -> n)
                                   (NotDelivered -> (project r 1))
                                   (TimedOut -> (project r 1))))
                   (NotDelivered -> -1)
                   (TimedOut -> (+ 0 (match (perform Meter level 0)
                                       ((Reply n) -> n)
                                       (NotDelivered -> -1)
                                       (TimedOut -> -2))))))))
